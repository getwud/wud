{
    "name": "wud-app",
    "version": "9.4.0",
    "description": "What'up Docker? the app",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc && npm run copy:openapi",
        "copy:openapi": "node -e \"const fs=require('fs'); fs.mkdirSync('dist/api', {recursive: true}); fs.copyFileSync('api/openapi.yaml', 'dist/api/openapi.yaml')\"",
        "start": "nodemon --exec ts-node index.ts | pino-pretty",
        "doc": ".docsify serve ./docs",
        "format": "prettier --write .",
        "lint:fix": "prettier --write . && eslint '**/*.ts'",
        "lint": "eslint '**/*.ts'",
        "test": "jest --coverage",
        "db:generate": "drizzle-kit generate"
    },
    "author": "fmartinou",
    "repository": "getwud/wud",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-ecr": "^3.1009.0",
        "@kubernetes/client-node": "^2.0.0",
        "@slack/web-api": "^8.2.0",
        "amqplib": "^2.0.1",
        "axios": "^1.20.0",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
        "body-parser": "^1.20.6",
        "capitalize": "2.0.4",
        "cors": "^2.8.6",
        "dockerode": "^5.0.1",
        "drizzle-orm": "^0.45.3",
        "express": "^4.22.2",
        "express-healthcheck": "0.1.0",
        "express-openapi-validator": "^5.6.2",
        "express-session": "^1.19.0",
        "flat": "5.0.2",
        "getmac": "6.6.0",
        "gotify-client": "0.4.2",
        "http-proxy-agent": "^7.0.2",
        "https-proxy-agent": "^7.0.6",
        "jiti": "^2.6.1",
        "joi": "^17.13.7",
        "joi-cron-expression": "1.0.1",
        "just-debounce": "1.1.0",
        "kafkajs": "2.2.4",
        "mqtt": "^5.16.0",
        "nats": "^2.29.3",
        "nocache": "4.0.0",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.0.14",
        "openid-client": "^6.8.8",
        "parse-docker-image-name": "3.0.0",
        "pass": "0.2.0",
        "passport": "0.7.0",
        "passport-anonymous": "1.0.1",
        "passport-http": "0.3.0",
        "passport-http-bearer": "^1.0.1",
        "pino": "^10.4.0",
        "pino-pretty": "^13.1.3",
        "prom-client": "15.1.3",
        "proxy-from-env": "^2.1.0",
        "pushover-notifications": "1.2.3",
        "semver": "^7.8.5",
        "set-value": "4.1.0",
        "snake-case": "3.0.4",
        "socks-proxy-agent": "^8.0.5",
        "sort-es": "^1.7.18",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.1",
        "yaml": "^2.9.1",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.8",
        "@types/bcryptjs": "^2.4.6",
        "@types/better-sqlite3": "^9.6.0",
        "@types/cors": "^2.8.19",
        "@types/dockerode": "^4.0.1",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.18.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.3",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.2",
        "@types/passport": "^1.0.17",
        "@types/passport-http-bearer": "^1.0.42",
        "@types/semver": "^7.8.0",
        "@types/supertest": "^7.2.1",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^10.0.0",
        "@types/yaml": "^1.9.6",
        "@types/yamljs": "^0.2.34",
        "babel-jest": "29.7.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "29.7.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.6.2",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0"
    }
