  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.4",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-cucumber": "2.0.0",
    "eslint-plugin-import": "2.30.0"
  }
}